# Optional environment for kimi-plugin-codex (copy to .env only if your host loads it).
# Prefer setting these in the host shell / process environment.

# Absolute path to the Kimi CLI binary (kimi / kimi.exe)
# KIMI_CLI_PATH=

# Job store directory (default: ~/.kimi-plugin-codex)
# KIMI_PLUGIN_CODEX_DATA_DIR=

# Best-effort host session scoping (usually injected by OpenAI Codex)
# CODEX_SESSION_ID=
# KIMI_PLUGIN_CODEX_HOST_SESSION=